PORT=8000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Network switch — false=mainnet, anything else=devnet
DEVNET=true

# Helius ($999/mo plan) — server-side only, never expose to client.
# Register BOTH mode URLs so toggling DEVNET flips the runtime target with no code change.
HELIUS_DEVNET_URL=
HELIUS_MAINNET_URL=
HELIUS_WS_DEVNET_URL=
HELIUS_WS_MAINNET_URL=
# Mainnet-only premium endpoints (gracefully fall back on devnet)
HELIUS_GATEKEEPER_URL=
LASERSTREAM_URL=
LASERSTREAM_API_KEY=
# Optional explicit override (wins over both mode URLs)
HELIUS_RPC_URL=
HELIUS_WS_URL=
# Legacy single-key fallback (used to derive URLs only if no mode URL is set)
HELIUS_API_KEY=

# Jupiter
JUPITER_API_URL=https://api.jup.ag

# Database
DATABASE_URL=
REDIS_URL=

# Cranker
CRANKER_PRIVATE_KEY=

# Buyback
BUYBACK_TOKEN_MINT=
TREASURY_PRIVATE_KEY=
BUYBACK_PCT=30
BUYBACK_INTERVAL_MS=60000
BUYBACK_MIN_SOL=0.01

# Telegram monitoring (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
