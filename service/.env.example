PORT=8000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Network switch — false=mainnet, anything else=devnet
DEVNET=true

# Helius ($999/mo plan) — server-side only, never expose to client
# Main RPC (general read + DAS + sendTransaction)
HELIUS_RPC_URL=
# Beta gatekeeper (high-throughput / priority send)
HELIUS_GATEKEEPER_URL=
# Enhanced WebSocket (real-time subscriptions)
HELIUS_WS_URL=
# Laserstream (ultra-low-latency Solana stream)
LASERSTREAM_URL=
LASERSTREAM_API_KEY=
# Legacy fallback — kept so old code paths still derive URLs if HELIUS_RPC_URL is empty
HELIUS_API_KEY=

# Jupiter
JUPITER_API_URL=https://api.jup.ag

# Database
DATABASE_URL=
REDIS_URL=

# Cranker
CRANKER_PRIVATE_KEY=

# Buyback
BUYBACK_TOKEN_MINT=
TREASURY_PRIVATE_KEY=
BUYBACK_PCT=30
BUYBACK_INTERVAL_MS=60000
BUYBACK_MIN_SOL=0.01

# Telegram monitoring (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
