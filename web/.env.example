NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_SITE_URL=

# Network switch — true=devnet, false=mainnet (single source of truth for both modes)
NEXT_PUBLIC_DEVNET=true

# Server-side only URLs for the /api/rpc + /api/sol-price route handlers.
# Register BOTH so toggling NEXT_PUBLIC_DEVNET flips upstream with no code change.
# NEVER use NEXT_PUBLIC_ for Helius URLs — they would inline into the client bundle.
HELIUS_DEVNET_URL=
HELIUS_MAINNET_URL=
# Optional explicit override (wins over both mode URLs)
HELIUS_RPC_URL=

# Program / feature flags
NEXT_PUBLIC_PROGRAM_ID=CcyByKGzRDK17icyNGAgdUN4q7WzbL1BPi4BNzqytyMP
NEXT_PUBLIC_FEATURE_TRADING=false
NEXT_PUBLIC_FEATURE_WALLET=false
NEXT_PUBLIC_FEATURE_REFUND=false
