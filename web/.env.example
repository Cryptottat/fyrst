NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_SITE_URL=

# Network switch — true=devnet, false=mainnet (this is the ONLY thing you change)
NEXT_PUBLIC_DEVNET=true

# Server-side only RPC for the /api/rpc proxy route handler.
# NEVER use NEXT_PUBLIC_ for Helius URLs — they would inline into the client bundle.
HELIUS_RPC_URL=

